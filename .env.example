#Логирование
# LOG_LEVEL — уровень логов приложения (INFO по умолчанию)
# SQL_ECHO=1 включает вывод SQL-запросов SQLAlchemy вместе со значениями
# параметров. В проде держать выключенным: в лог попадают email'ы, имена
# и SignatureValue платежей.
LOG_LEVEL=INFO
SQL_ECHO=0
