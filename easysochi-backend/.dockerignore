# Контекст сборки бэкенда. Docker читает .dockerignore из корня контекста,
# то есть отсюда, а не из корня репозитория.
#
# Шаблоны не рекурсивны сами по себе, поэтому для вложенных путей "**/".

# Python-мусор
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
.coverage

# Виртуальные окружения с машины разработчика
.venv
venv
ENV

# Служебное
.git
.gitignore

# Секреты: в контекст они попадать не должны ни при каких обстоятельствах
.env
**/*.env

# ВАЖНО: app/test не игнорировать — тесты прогоняются внутри контейнера
# (docker exec easysochi_contact_api ... app/test/test_payment_api.py),
# значит они должны быть в образе.
