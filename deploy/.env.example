# форма заявки
# Telegram больше не используется: api.telegram.org с этого сервера
# недоступен, уведомления уходят почтой (блок ниже). Переменные оставлены,
# чтобы не ломать старые .env, но ничего не отправляют.
TELEGRAM_TOKEN=
CHAT_ID=

#УВЕДОМЛЕНИЯ МЕНЕДЖЕРУ (почта)
# Кому уходят письма о заявках, запросах звонка и платежах.
# Несколько адресов — через запятую. Пусто = писать некому: заявка
# сохранится, посетитель увидит "спасибо", а менеджер не узнает ничего.
MANAGER_EMAILS=
# Почтовый сервер отправителя. Если SMTP_HOST пуст, письма не отправляются
# вовсе — приложение поднимется и скажет об этом в логе при старте строкой
# "Уведомления, почта: ...". Этой строкой и проверяется настройка.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Два разных способа шифрования, путать нельзя:
#   SMTP_SSL=1      — соединение сразу в TLS, обычный порт 465
#   SMTP_STARTTLS=1 — открытое соединение, потом команда STARTTLS, порт 587
SMTP_SSL=0
SMTP_STARTTLS=1
SMTP_TIMEOUT=20
# Адрес в поле From. Пусто = берётся SMTP_USER: почти у всех провайдеров
# отправка от чужого адреса отклоняется.
EMAIL_FROM=
EMAIL_FROM_NAME=EASYSOCHI

# фронт: базовый URL сайта, используется как return_url при оплате
DOMAIN_URL=https://easysochi.pro

#база данных для сайта
SERVER_IP=
POSTGRES_DB=easysochi
POSTGRES_USER=easysochi_
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=postgresql+asyncpg://easysochi_
DATABASE_URL_SYNC=postgresql+psycopg2://easysochi_

#ПЛАТЁЖНАЯ СИСТЕМА
# Активная платёжная система. Работает ровно одна.
# Допустимые значения:
#   robokassa — Robokassa, вебхук приходит form-data, ответ "OK<InvId>"
#   yookassa  — ЮKassa, вебхук приходит JSON, достаточно кода 200
# Любое другое значение — контейнер contact_api не поднимется с ошибкой
# "Неизвестный PAYMENT_PROVIDER". Переключение: правка этой переменной
# и docker compose up -d.
# Заполнять нужно только блок выбранной системы, второй может оставаться пустым.
PAYMENT_PROVIDER=robokassa

#ROBOKASSA (используется при PAYMENT_PROVIDER=robokassa)
ROBOKASSA_SHOP_ID=xxxxXXXX
# Пароль #1 — подпись при создании платежа
ROBOKASSA_PASSWORD_1=xxxxxxxxxxxxxxxxxxxxx
# Пароль #2 — проверка подписи входящего вебхука
ROBOKASSA_PASSWORD_2=xxxxxxxxxxxxxxxxxxx
# 1 — тестовый режим (к URL оплаты добавляется IsTest=1), 0 — боевой
ROBOKASSA_TEST_MODE=0

#UKASSA (используется при PAYMENT_PROVIDER=yookassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ключи тестового магазина. Кодом НЕ читаются: чтобы работать в тестовом
# режиме, подставьте их в YOOKASSA_SHOP_ID / YOOKASSA_SECRET_KEY выше.
YOOKASSA_SHOP_ID_TEST=
YOOKASSA_SECRET_KEY_TEST=

#Порты NGINX
SITE_PORT_EXTERNAL=
API_PORT_EXTERNAL=

#Домен
DOMAIN_PRO=easysochi.pro
PRO_STATS=stats.easysochi.pro

#Логирование
# LOG_LEVEL — уровень логов приложения (INFO по умолчанию)
# SQL_ECHO=1 включает вывод SQL-запросов SQLAlchemy вместе со значениями
# параметров. В проде держать выключенным: в лог попадают email'ы, имена
# и SignatureValue платежей.
LOG_LEVEL=INFO
SQL_ECHO=0
