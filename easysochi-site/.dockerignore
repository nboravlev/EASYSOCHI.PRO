# Контекст сборки сайта. Docker читает .dockerignore из корня контекста,
# то есть отсюда, а не из корня репозитория — корневой файл на эту сборку
# никогда не влиял.
#
# Шаблоны здесь не рекурсивны сами по себе, в отличие от .gitignore:
# "__pycache__" совпало бы только с каталогом в корне контекста, поэтому
# для вложенных путей нужен явный "**/".

# Результат работы Hugo и его кеш. public пересоздаётся командой
# hugo --minify, а устаревший resources с машины разработчика может дать
# в образе не тот CSS/JS, что ожидается.
public
resources
.hugo_build.lock

# Служебное
.git
.gitignore
.gitmodules
README.md
LICENSE

# Одноразовые скрипты обработки картинок, в рантайме не нужны
round_image.py
round_with_r.py
**/__pycache__

# Служебные файлы темы: на сборку не влияют, только раздувают контекст
themes/*/.git
themes/*/.github
themes/*/README.md

# ВАЖНО: nginx.conf не игнорировать — его копирует production-стадия
# (COPY nginx.conf /etc/nginx/conf.d/default.conf) прямо из контекста.
# content/**/*.md — содержимое сайта, тоже трогать нельзя: шаблон README.md
# выше привязан к корню контекста и вложенные .md не задевает.
